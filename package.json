{
  "name": "geminiboard",
  "private": true,
  "description": "Interface locale au style de Claude pour piloter Gemini CLI, avec journal SQLite",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:ci": "node tools/run-tests.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tools/ci-annotations.mjs --test-reporter-destination=stdout",
    "spike": "node spike/capture.mjs"
  }
}
